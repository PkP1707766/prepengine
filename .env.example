# Copy to .env.local and fill in. Only VITE_* variables reach the browser.
# Anything prefixed VITE_ is compiled into the public JavaScript bundle —
# never put a secret here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# ---------------------------------------------------------------------------
# NOT used by the browser. These belong in Supabase edge-function secrets:
#   npx supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=...
#
#   RAZORPAY_KEY_ID          rzp_live_xxxxxxxx
#   RAZORPAY_KEY_SECRET      the matching secret
#   RAZORPAY_WEBHOOK_SECRET  the secret you set on the Razorpay webhook
#   ALLOWED_ORIGINS          https://your-domain.com,https://www.your-domain.com
#
# The Supabase service-role key is never needed by this app and must never be
# committed or exposed. Edge functions receive it automatically.
# ---------------------------------------------------------------------------
